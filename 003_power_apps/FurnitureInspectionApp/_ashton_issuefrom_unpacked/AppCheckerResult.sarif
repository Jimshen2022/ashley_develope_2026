elativeAddress":0,"fullyQualifiedName":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1.ReportDate_DataCard1.DataCardValue14.AccessibleLabel"}},"logicalLocations":[{"fullyQualifiedName":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1.ReportDate_DataCard1.DataCardValue14.AccessibleLabel"}],"properties":{"module":"MainScreen1","type":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1.ReportDate_DataCard1.DataCardValue14","member":"AccessibleLabel"}}],"properties":{"level":"Medium"}},{"ruleId":"acc-AccessibleLabelNeeded","ruleIndex":0,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1.附件_DataCard1.DataCardValue15.AccessibleLabel"}},"logicalLocations":[{"fullyQualifiedName":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1.附件_DataCard1.DataCardValue15.AccessibleLabel"}],"properties":{"module":"MainScreen1","type":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1.附件_DataCard1.DataCardValue15","member":"AccessibleLabel"}}],"properties":{"level":"Medium"}},{"ruleId":"app-UnusedVariables","ruleIndex":2,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"MainScreen1.deleteCancelled"}},"logicalLocations":[{"fullyQualifiedName":"MainScreen1.deleteCancelled"}],"properties":{"module":"MainScreen1","type":"MainScreen1","member":"deleteCancelled"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":3,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1.OnSuccess"}},"logicalLocations":[{"fullyQualifiedName":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1.OnSuccess"}],"properties":{"module":"MainScreen1","type":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1","member":"OnSuccess"}}],"properties":{"level":"Medium"}},{"ruleId":"app-IndexedAccessViaCopy","ruleIndex":4,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1.OnSuccess"}},"logicalLocations":[{"fullyQualifiedName":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1.OnSuccess"}],"properties":{"module":"MainScreen1","type":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1","member":"OnSuccess"}}],"properties":{"level":"Medium"}},{"ruleId":"app-NumericPropertySizeWarning","ruleIndex":5,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1.附件_DataCard1.DataCardValue15"}},"logicalLocations":[{"fullyQualifiedName":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1.附件_DataCard1.DataCardValue15"}],"properties":{"module":"MainScreen1","type":"MainScreen1.ScreenContainer1.BodyContainer1.RightContainer1.MainContainer1.Form1.附件_DataCard1.DataCardValue15"}}],"properties":{"level":"Low"}}],"tool":{"driver":{"name":"PowerApps app checker","fullName":"PowerApps app checker","version":"1.349","rules":[{"id":"acc-AccessibleLabelNeeded","messageStrings":{"issue":{"text":"Missing accessible label"}},"properties":{"howToFix":["Edit the accessible label property to describe the item."],"whyFix":"If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-TabIndexShouldBeDefinedForInteractiveControl","messageStrings":{"issue":{"text":"Missing tab stop"}},"properties":{"howToFix":["Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."],"whyFix":"People who use the keyboard with your app will not be able to access this element without a tab stop.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"app-UnusedVariables","messageStrings":{"issue":{"text":"未用变量"}},"properties":{"howToFix":["请删除未用变量。"],"whyFix":"此变量已声明，但未被任何控件引用，因此不是必需的。","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ForAllWithMutation","messageStrings":{"issue":{"text":"在 ForAll 中变更集合或数据源可能会触发过多的规则重新评估"}},"properties":{"howToFix":["由于 ForAll 返回表，将其结果作为单次批处理调用中的变更函数的输入。例如，将 ForAll(source, Collect(c, { ... })) 替换为 Collect(c, ForAll(source, { ... })); 同样的模式适用于 Patch 和 Remove。单个批处理的变更发出一个更改通知，而不是每次迭代发出一个更改通知。","对于针对数据源的普通每行更新或删除，首选在 ForAll 外部调用一次的可委派 UpdateIf 或 RemoveIf 函数，而不是使用 ForAll 进行迭代。"],"whyFix":"在 ForAll 体内使用 Collect、Patch、Remove 或其他变更函数，会导致每次迭代都变更目标集合或数据源。每个依赖于该集合或数据源的控件属性都会根据每个变更重新计算，这会将小循环转换为数千个规则评估，对于连接的数据源，则为每行一个网络请求。","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-IndexedAccessViaCopy","messageStrings":{"issue":{"text":"使用 Index 在给定位置读取记录"}},"properties":{"howToFix":["将 Last(FirstN(t, n)) 替换为 Index(t, Min(CountRows(t), n))，t 和 n 保持与原表达式中相同。Min 保持原有行为，当 n 在范围内时返回第 n 行，当 n 大于行数时返回最后一行而非报错。如果你已确定 n 在 1 到 CountRows(t) 之间，可以简化为 Index(t, n)。","将 First(LastN(t, n)) 替换为 Index(t, Max(1, CountRows(t) - n + 1))，t 和 n 保持与原表达式相同。Max 保留原始行为 - 当 n 在范围内时，它将返回 n-th-from-end 行，当 n 大于行计数时，它将返回第一行而不是错误。如果你已确定 n 在 1 到 CountRows(t) 之间，则可以简化为 Index(t, CountRows(t) - n + 1)。"],"whyFix":"在表达式如 Last(FirstN(t, n)) 和 First(LastN(t, n)) 中，t 是表，n 是行位置，这两种形式都会复制表的前 n 行，只为返回边界处的一条记录。Index(t, ...) 直接返回指定位置的记录，无需构建中间副本，避免复制成本及复制触发的每行操作。当 n 在 1 到 t 的行数之间(标识符 t 和 n 应保持与原表达式中相同)时，两种形式会返回相同记录; 当 n 超过行数时，Index 会出现错误，而 FirstN/LastN 形式会限制在边界行，因此如果数据可能小于 n，建议使用 Min(CountRows(t), n) 之类的限制公式。","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-NumericPropertySizeWarning","messageStrings":{"issue":{"text":"允许上传较大的文件，最大 10 MB"}},"properties":{"howToFix":["考虑是否需要此大小的附件。"],"whyFix":"建议在所有受支持的平台上执行测试，确保可以成功上传此大小的附件。","componentType":"app","primaryCategory":"performance","level":"Low"}}]}},"invocations":[{"executionSuccessful":true}],"columnKind":"utf16CodeUnits"}]}